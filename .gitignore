/node_modules
/package-lock.json

# rendered videos and stills (re-create with npm run render); keep the masters elsewhere
/out/

# voice model (~340 MB): downloaded by `npm run setup`
/tools/models/

# per-episode audio build output is regenerated by `npm run voice` + `npm run sound`,
# except the timeline, which is small and lets the preview open without regenerating
episodes/*/build/*.wav
episodes/*/build/*.srt

__pycache__/
