    {
      "id": "h2",
      "scene": "hook",
      "text": "It lasted 72 seconds...",
      "say": "It lasted seventy-two seconds...",
      "pause": 0.25
    },
    {
      "id": "h3",
      "scene": "hook",
      "text": "and it never came back.",
