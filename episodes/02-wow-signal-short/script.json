    },
    {
      "id": "y1",
      "scene": "hydrogen",
      "text": "It came in on the hydrogen frequency, right where scientists expected an alien signal might be.",
      "pause": 0.4
    },
    {
      "id": "s1",
      "scene": "search",
      "text": "Astronomers have searched that patch of sky for decades.",
      "pause": 0.25
